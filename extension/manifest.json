{
  "manifest_version": 3,
  "name": "Tab Audio Recorder",
  "version": "1.0.0",
  "description": "Record audio from any browser tab and save it as an M4A file. One click: starts when sound plays, click again to save.",
  "minimum_chrome_version": "116",
  "homepage_url": "https://github.com/DracoLi/tab-audio-recorder",
  "permissions": ["activeTab", "tabCapture", "offscreen", "downloads"],
  "background": { "service_worker": "background.js" },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": {
    "default_title": "Record this tab's audio",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  }
}
